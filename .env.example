# Local development works without external services; drafts stay in your browser.
APP_URL=http://127.0.0.1:3000
# GGG requires an HTTPS registered domain for confidential-client callbacks.
POE_CLIENT_ID=
POE_CLIENT_SECRET=
POE_CONTACT=
POE_REDIRECT_URI=
# 64 hexadecimal characters; required when OAuth is enabled.
TOKEN_ENCRYPTION_KEY=
# Optional locally; required for persistent account sessions and worker history.
DATABASE_URL=
REDIS_URL=
TREE_EXPORT_URL=https://raw.githubusercontent.com/grindinggear/poe2-skilltree-export/main/data.json
