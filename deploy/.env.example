APP_URL=https://poe2.nonglabs.cloud
# CI verifies this private endpoint independently of public DNS/NPM setup.
TAILNET_URL=https://labs.tail262442.ts.net:3211
# NPM overwrites X-Real-IP; used to rate-limit individual public visitors.
TRUST_PROXY=true
WEB_PORT=3210
# The deployment job supplies an immutable GHCR digest.
EXILE_ATLAS_IMAGE=ghcr.io/mrwinrock/exile-atlas:master
# Generate fresh server values; do not reuse the development database password.
POSTGRES_PASSWORD=
TOKEN_ENCRYPTION_KEY=
# GGG account access stays unavailable until an approved client is configured.
POE_CLIENT_ID=
POE_CLIENT_SECRET=
POE_CONTACT=
POE_REDIRECT_URI=
